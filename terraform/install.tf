# Leostream software installation through Azure Run Command.
#
# Run Command executes server-side, so a dropped client connection cannot
# interrupt an install in progress. That is the same reason the PowerShell
# installers use it, and why they had to be hardened against client-side
# disconnects; Terraform polls the operation rather than holding a single long
# HTTP request, so it recovers from the same fault naturally.

locals {
  # Values are single-quoted for the shell, with any embedded single quote
  # escaped, so an installer URI containing a query string cannot break out.
  broker_prelude = <<-EOT
    #!/bin/bash
    # Variable prelude generated by Terraform (install.tf).
    INSTALLER_URI='${replace(var.broker_installer_uri, "'", "'\\''")}'
    VM_NAME='${replace(var.broker_name, "'", "'\\''")}'
    LICENSE_KEY='${replace(var.leostream_license_key, "'", "'\\''")}'
    OS_UPDATE_MODE='${var.skip_os_update ? "skip" : "update"}'
  EOT

  gateway_prelude = <<-EOT
    #!/bin/bash
    # Variable prelude generated by Terraform (install.tf).
    INSTALLER_URI='${replace(var.gateway_installer_uri, "'", "'\\''")}'
    VM_NAME='${replace(var.gateway_name, "'", "'\\''")}'
    BROKER_ADDRESS='${replace(var.broker_private_ip, "'", "'\\''")}'
    OS_UPDATE_MODE='${var.skip_os_update ? "skip" : "update"}'
    ADMIN_PORT='${var.broker_admin_port == null ? "" : tostring(var.broker_admin_port)}'
  EOT

  # The installer bodies are plain bash files so they need no Terraform
  # escaping and can be checked with "bash -n". Their own shebang line becomes a
  # harmless comment once the prelude is in front.
  #
  # Every carriage return is stripped. On a Windows checkout these files and the
  # heredocs above can carry CRLF, and a CR breaks the shebang on RHEL and turns
  # "set -euo pipefail" into an invalid option. .gitattributes asks for LF, but
  # that only governs what git writes, so normalise here as well rather than
  # depend on how the repository was cloned. Install-LeostreamBroker.ps1 does
  # the same for its embedded payload.
  broker_script  = replace(join("\n", [local.broker_prelude, file("${path.module}/scripts/install-broker.sh")]), "\r", "")
  gateway_script = replace(join("\n", [local.gateway_prelude, file("${path.module}/scripts/install-gateway.sh")]), "\r", "")
}

resource "azurerm_virtual_machine_run_command" "broker" {
  count = var.install_software ? 1 : 0

  name               = "install-leostream-broker"
  location           = local.location
  virtual_machine_id = azurerm_linux_virtual_machine.broker.id

  source {
    script = local.broker_script
  }

  # A full dnf update plus the Leostream install regularly runs past half an
  # hour on a cold image.
  timeouts {
    create = "90m"
    update = "90m"
    delete = "30m"
  }
}

resource "azurerm_virtual_machine_run_command" "gateway" {
  count = var.install_software ? 1 : 0

  name               = "install-leostream-gateway"
  location           = local.location
  virtual_machine_id = azurerm_linux_virtual_machine.gateway.id

  source {
    script = local.gateway_script
  }

  timeouts {
    create = "90m"
    update = "90m"
    delete = "30m"
  }
}
